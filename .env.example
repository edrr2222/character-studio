# Credenciales del panel /admin (protegido con autenticación básica).
# Sin estas dos variables, el panel queda BLOQUEADO por defecto (fail-closed).
ADMIN_USER=cambia_este_usuario
ADMIN_PASSWORD=cambia_esta_clave_larga_y_unica

# Puerto (Render lo define solo, no hace falta tocarlo ahí)
PORT=3000

# Dominio exacto desde el que se sirve el admin/viewer, para restringir CORS en producción.
# Ejemplo: https://tu-app.onrender.com
ALLOWED_ORIGIN=
